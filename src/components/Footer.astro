---
import logo from '../assets/logo/logo-bila.svg?raw';
import { site } from '../data/site.js';
import { oblasti } from '../data/oblasti.js';
import { partneri } from '../data/partneri.js';
import PartnerLogo from './PartnerLogo.astro';
import { Image } from 'astro:assets';
import domovLogo from '../assets/logo/domov-sb.png';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Jan Syblík – úvodní stránka" set:html={logo} />
      <p>Specialista na Berounsko, Prahu a Kladno.</p>
    </div>
    <div>
      <h2 class="footer__h">Kontakt</h2>
      <ul>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="https://www.jansyblik.cz/">www.jansyblik.cz</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Web</h2>
      <ul>
        <li><a href="/#sluzby">Služby</a></li>
        <li><a href="/#nabidky">Aktuální nabídka</a></li>
        <li><a href="/#dotazy">Časté dotazy</a></li>
        <li><a href="/odhad-ceny-nemovitosti/">Ocenění zdarma</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__h">Oblasti</h2>
      <ul>{oblasti.map((o) => <li>{o.hotovo ? <a href={o.url} title={`Prodej nemovitostí ${o.nazev}`}>{o.nazev}</a> : <span>{o.nazev}</span>}</li>)}</ul>
    </div>
    <div class="footer__domov">
      <a href="https://www.domov-beroun.cz/" target="_blank" rel="noopener" aria-label="Realitní kancelář Domov Beroun">
        <Image src={domovLogo} alt="Domov – realitní kancelář" widths={[130, 260]} sizes="130px" />
      </a>
      <a class="footer__domov-link" href="https://www.domov-beroun.cz/" target="_blank" rel="noopener">www.domov-beroun.cz</a>
    </div>
  </div>
  {partneri.length > 0 && <div class="wrap"><div class="footer__partners">
    <h2 class="footer__h">Partneři</h2>
    <ul class="footer__plist">
      {partneri.map((p) => (
        <li><a class="footer__partner" href={p.url} target="_blank" rel="noopener" title={p.popis} aria-label={`${p.nazev} – ${p.popis}`}><PartnerLogo logo={p.logo} nazev={p.nazev} /></a></li>
      ))}
    </ul>
  </div></div>}
  <div class="wrap"><div class="footer__bottom">
    <span>© {year} Jan Syblík</span>
    <span class="footer__links">
      <a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a>
      <button type="button" onclick="window.openConsent && window.openConsent()">Nastavení cookies</button>
    </span>
  </div></div>
</footer>

<style>
  .footer { background: #121212; color: #d6d6d6; padding: 72px 0 28px; font-size: 15px; }
  .footer__grid { display: grid; grid-template-columns: 1.3fr 1fr .9fr 1.2fr auto; gap: 36px; }
  .footer__grid li > span { color: #d6d6d6; }
  .footer__partners { margin-top: 48px; padding-top: 28px; border-top: 1px solid #2e2e2e; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 40px; }
  .footer__partners .footer__h { margin: 0; }
  .footer__plist { display: flex !important; flex-wrap: wrap; align-items: center; gap: 20px 40px !important; }
  .footer__partner { --pl-main: #ffffff; --pl-accent: #7fb3d9; display: inline-flex; opacity: .85; transition: opacity .2s, transform .2s; }
  .footer__partner:hover { opacity: 1; transform: scale(1.04); text-decoration: none !important; }
  .footer__domov { display: grid; gap: 14px; justify-items: center; align-content: start; justify-self: start; width: max-content; }
  .footer__domov :global(img) { width: 130px; height: auto; display: block; }
  .footer__domov-link { font-size: 15px; }
  .footer__logo { display: block; width: 230px; margin-bottom: 20px; }
  .footer__logo :global(svg) { width: 100%; height: auto; display: block; }
  .footer__brand p { max-width: 420px; color: #b5b5b5; }
  .footer__h { font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #fff; margin-bottom: 16px; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .footer a { color: #d6d6d6; text-decoration: none; }
  .footer a:hover { color: #fff; text-decoration: underline; }
  .footer__bottom { margin-top: 28px; padding-top: 24px; border-top: 1px solid #2e2e2e; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: #9a9a9a; font-size: 14px; }
  .footer__links { display: flex; gap: 18px; flex-wrap: wrap; }
  .footer__links a, .footer__links button { color: #b5b5b5; }
  .footer__links button { background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: none; }
  .footer__links button:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 1100px) { .footer__grid { grid-template-columns: 1fr 1fr 1fr; } }
  @media (max-width: 760px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr 1fr; gap: 28px 20px; } .footer__brand { grid-column: 1 / -1; } .footer__domov { margin-top: 4px; } .footer__domov :global(img) { width: 100px; } .footer { font-size: 14px; } }
</style>
