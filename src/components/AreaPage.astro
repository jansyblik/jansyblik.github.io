---
// Šablona podstránky pro oblast: krátký místní průvodce pro prodávající.
// Bez fotek a bez formuláře – tlačítka vedou na formulář na hlavní stránce.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import MobileBar from './MobileBar.astro';
import { site } from '../data/site.js';

const { p } = Astro.props;
// Nezlomitelná mezera po jednopísmenných předložkách a spojkách (aby „v“, „o“, „a“ nezůstaly na konci řádku).
const nb = (t) => t.replace(/(?<=^|[\s(„])([kKsSvVzZoOuUaAiI])\s+/g, '$1\u00a0');
// Odkazy v textu ve tvaru [text](/adresa/).
const parts = (t) => t.split(/(\[[^\]]+\]\([^)]+\)|\*\*[^*]+\*\*)/).filter(Boolean).map((x) => { const m = x.match(/^\[([^\]]+)\]\(([^)]+)\)$/); if (m) return { text: m[1], href: m[2] }; const b = x.match(/^\*\*([^*]+)\*\*$/); return b ? { text: b[1], strong: true } : { text: x }; });
const pageUrl = site.url + p.path;
const toForm = '/#kontakt';
const toFormSell = '/?volba=prodat#kontakt';

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: p.h1,
  description: p.description,
  url: pageUrl,
  inLanguage: 'cs',
  author: { '@type': 'Person', name: 'Jan Syblík', jobTitle: 'Realitní makléř', url: site.url + '/' },
  publisher: { '@type': 'RealEstateAgent', '@id': site.url + '/#makler', name: 'Jan Syblík – realitní makléř' },
  about: p.areaServed.map((n) => ({ '@type': 'Place', name: n })),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Jan Syblík', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: p.breadcrumb, item: pageUrl },
  ],
};
---
<Base title={p.title} description={p.description} path={p.path} jsonLd={[article, crumbs]}>
  <Header />
  <main id="obsah">
    <article class="guide">
      <div class="wrap guide__wrap">
        <nav class="crumbs" aria-label="Drobečková navigace"><a href="/">Úvod</a><span aria-hidden="true">›</span><span>{p.breadcrumb}</span></nav>

        <header class="guide__head">
          <span class="eyebrow">{p.eyebrow}</span>
          <h1>{p.h1}</h1>
          <p class="guide__intro">{nb(p.intro)}</p>
          <p class="guide__meta">Jan Syblík, realitní makléř · Domov Beroun · aktualizováno {p.updated}</p>
        </header>

        <div class="guide__body">
          {p.sections.map((s) => (
            <section>
              <h2>{s.h2}</h2>
              {(s.p || []).map((t) => <p>{parts(nb(t)).map((x) => x.href ? <a href={x.href}>{x.text}</a> : x.strong ? <strong>{x.text}</strong> : x.text)}</p>)}
              {s.list && <ul>{s.list.map((t) => <li>{parts(nb(t)).map((x) => x.href ? <a href={x.href}>{x.text}</a> : x.text)}</li>)}</ul>}
              {(s.after || []).map((t) => <p>{nb(t)}</p>)}
            </section>
          ))}
        </div>
      </div>
    </article>

    <section class="guide-cta theme-beige" aria-labelledby="cta-h">
      <div class="wrap guide__wrap">
        <h2 id="cta-h">{p.ctaH2}</h2>
        <p>{nb(p.ctaText)}</p>
        <div class="guide-cta__actions">
          <a class="btn btn--primary" href={toForm}>Ocenění zdarma</a>
          <a class="btn btn--dark" href={toFormSell}>Chci prodat</a>
        </div>
        <p class="guide-cta__phone">Nebo mi rovnou zavolejte: <a href={site.phoneHref}><Icon name="phone" />{site.phone}</a></p>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .guide { background: #fff; color: #111; padding: clamp(28px, 5vh, 48px) 0 clamp(56px, 9vh, 96px); }
  .guide__wrap { max-width: calc(760px + 2 * var(--gutter)); }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: #6a6a6a; margin-bottom: clamp(32px, 6vh, 64px); }
  .crumbs a { color: #6a6a6a; text-decoration: none; }
  .crumbs a:hover { color: var(--cobalt); text-decoration: underline; }
  .guide__head h1 { font-size: clamp(32px, 4vw, 48px); margin-top: 16px; }
  .guide__intro { font-size: clamp(18px, 1.6vw, 20px); color: #2f2f2f; margin-top: 20px; line-height: 1.6; }
  .guide__meta { font-size: 14px; color: #6a6a6a; margin-top: 18px; padding-bottom: 28px; border-bottom: 1px solid #e4e1db; }
  .guide__body section { margin-top: clamp(32px, 5vh, 44px); }
  .guide__body h2 { font-size: clamp(22px, 2.2vw, 27px); }
  .guide__body p { font-size: 17px; line-height: 1.7; color: #2b2b2b; margin-top: 12px; }
  .guide__body ul { margin: 12px 0 0; padding-left: 22px; display: grid; gap: 8px; }
  .guide__body li { font-size: 17px; line-height: 1.6; color: #2b2b2b; padding-left: 4px; }
  .guide__body li::marker { color: var(--cobalt); }
  .guide__body a { color: inherit; text-decoration: underline; text-decoration-color: rgba(0,0,0,.3); text-underline-offset: 3px; }
  .guide__body a:hover { color: var(--cobalt); text-decoration-color: var(--cobalt); }

  .guide-cta { padding: clamp(56px, 9vh, 96px) 0; }
  .guide-cta h2 { font-size: clamp(26px, 3vw, 36px); }
  .guide-cta > .wrap > p:not(.guide-cta__phone) { font-size: 17px; color: var(--text-2); margin-top: 12px; max-width: 620px; }
  .guide-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .guide-cta :global(.btn--dark) { border-color: #111; color: #111; background: #fff; }
  .guide-cta :global(.btn--dark:hover) { background: #111; color: #fff; }
  .guide-cta__phone { margin-top: 22px; font-size: 16px; color: var(--text-2); }
  .guide-cta__phone a { display: inline-flex; align-items: center; gap: 6px; margin-left: 4px; font-weight: 700; color: #111; text-decoration: none; }
  .guide-cta__phone a:hover { text-decoration: underline; }
  .guide-cta__phone :global(svg) { width: 17px; height: 17px; color: var(--cobalt); }

  @media (max-width: 860px) {
    .guide-cta__actions .btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
