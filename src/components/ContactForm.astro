---
import { site } from '../data/site.js';
const endpoint = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : '';
---
<form class="form" id="poptavka" action={endpoint || '#'} method="POST" data-endpoint={endpoint} novalidate>
  <fieldset class="form__choice">
    <legend class="sr-only">Co potřebujete</legend>
    <label><input type="radio" name="Požadavek" value="Ocenění zdarma" checked /> <span>Ocenění zdarma</span></label>
    <label><input type="radio" name="Požadavek" value="Chci prodat" /> <span>Chci prodat</span></label>
  </fieldset>

  <div class="form__row">
    <div class="field">
      <label for="f-jmeno">Jméno a příjmení *</label>
      <input id="f-jmeno" name="Jméno" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="f-telefon">Telefon *</label>
      <input id="f-telefon" name="Telefon" type="tel" autocomplete="tel" inputmode="tel" required />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="f-obec">Lokalita *</label>
      <input id="f-obec" name="Lokalita" autocomplete="address-level2" required placeholder="např. Zdice" />
    </div>
    <div class="field">
      <label for="f-typ">Typ nemovitosti *</label>
      <select id="f-typ" name="Typ nemovitosti" required>
        <option value="">Vyberte</option>
        <option>Byt</option>
        <option>Dům</option>
        <option>Chata</option>
        <option>Pozemek</option>
        <option>Komerční</option>
        <option>Jiné</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="f-email">E-mail *</label>
    <input id="f-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="f-zprava">Zpráva <span class="form__opt">(nepovinné)</span></label>
    <textarea id="f-zprava" name="Zpráva" rows="2" placeholder="Velikost, stav, cokoli důležitého"></textarea>
  </div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="form__trap" aria-hidden="true" />
  <input type="hidden" name="_subject" value="Nová poptávka z webu jansyblik.cz" />

  <button type="submit" class="btn btn--primary form__submit">Odeslat nezávazně</button>
  <p class="form__legal">
    Údaje použiji jen k vyřízení poptávky.&nbsp;<a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a>
  </p>
  <p class="form__status" role="status" aria-live="polite"></p>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById('poptavka'); if (!form) return;
    // Tlačítka s data-volba přepnou formulář na správnou volbu (Ocenění zdarma / Chci prodat).
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-volba]'); if (!a) return;
      var r = form.querySelector('input[name="Požadavek"][value="' + a.dataset.volba + '"]');
      if (r) r.checked = true;
    });
    // Odkaz z podstránky ve tvaru /?volba=prodat#kontakt předvybere „Chci prodat“.
    if (new URLSearchParams(location.search).get('volba') === 'prodat') {
      var rp = form.querySelector('input[name="Požadavek"][value="Chci prodat"]');
      if (rp) rp.checked = true;
    }
    var status = form.querySelector('.form__status');
    var btn = form.querySelector('.form__submit');
    function say(msg, ok) { status.textContent = msg; status.dataset.state = ok ? 'ok' : 'error'; }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var bad = Array.prototype.find.call(form.querySelectorAll('[required]'), function (el) { return !el.value.trim(); });
      if (bad) { say('Vyplňte prosím povinná pole označená hvězdičkou.', false); bad.focus(); return; }
      var endpoint = form.dataset.endpoint;
      if (!endpoint) { say('Formulář se právě nastavuje. Zavolejte mi prosím, nebo napište e-mail.', false); return; }
      btn.disabled = true; btn.textContent = 'Odesílám…';
      fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(function (r) {
          if (!r.ok) throw new Error();
          var kind = (form.querySelector('[name="Požadavek"]:checked') || {}).value;
          if (window.trackLead) window.trackLead(kind === 'Chci prodat' ? 'prodej' : 'oceneni');
          form.reset();
          say('Děkuji za vaši poptávku. Ozvu se vám do 24 hodin.', true);
        })
        .catch(function () { say('Odeslání se nepovedlo. Zkuste to prosím znovu, nebo mi zavolejte.', false); })
        .finally(function () { btn.disabled = false; btn.textContent = 'Odeslat nezávazně'; });
    });
  })();
</script>

<style>
  .form { display: grid; gap: 12px; background: var(--panel); border: 1px solid var(--line); color: var(--text); padding: clamp(18px, 2.4vw, 26px); border-radius: 6px; }
  .form__opt { font-weight: 400; color: var(--muted); }
  .form__choice { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .form__choice label { position: relative; cursor: pointer; }
  .form__choice input { position: absolute; opacity: 0; }
  .form__choice span { display: flex; align-items: center; justify-content: center; min-height: 48px; border: 1.5px solid #3a4670; background: #262c40; color: #aab6dc; border-radius: var(--radius); font-weight: 700; font-size: 15px; transition: background .15s, color .15s, border-color .15s; }
  .form__choice label:hover span { border-color: #5a6aa8; color: #d3dbf5; }
  .form__choice input:checked + span { border-color: var(--cobalt); background: var(--cobalt); color: #fff; }
  .form__choice input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .field { display: grid; gap: 5px; }
  .field label { font-size: 14px; font-weight: 700; }
  .field input, .field select, .field textarea {
    width: 100%; font: inherit; font-size: 16px; color: #111; background: #fff;
    border: 1.5px solid #fff; border-radius: var(--radius); padding: 11px 14px; min-height: 48px;
  }
  .field textarea { resize: vertical; min-height: 64px; }
  .field input::placeholder, .field textarea::placeholder { color: #8a8a8a; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--cobalt); box-shadow: 0 0 0 3px rgba(123,151,255,.45); }
  .form__hint { font-size: 14px; color: var(--muted); margin-bottom: -6px; }
  .form__submit { width: 100%; min-height: 52px; font-size: 17px; }
  .form__submit:disabled { opacity: .7; cursor: wait; }
  .form__legal { font-size: 12.5px; color: var(--muted); line-height: 1.45; }
  .form__legal a { color: var(--text-2); }
  .form__trap { position: absolute; left: -9999px; }
  .form__status:empty { display: none; }
  .form__status { font-weight: 700; padding: 12px 14px; border-radius: var(--radius); }
  .form__status[data-state='ok'] { background: #12341f; color: #9be3b5; }
  .form__status[data-state='error'] { background: #3a1616; color: #f3a6a6; }
  @media (max-width: 600px) { .form__row { grid-template-columns: 1fr; } }
</style>
