---
import { site } from '../data/site.js';
const enabled = Boolean(site.gaId || site.googleAdsId || site.sklikRetargetingId || site.sklikConversionId);
const cfg = {
  ads: site.googleAdsId,
  adsLabel: site.googleAdsLeadLabel,
  sklikRtg: site.sklikRetargetingId,
  sklikConv: site.sklikConversionId,
};
---
{enabled && (
  <div class="consent" id="consent" role="dialog" aria-live="polite" aria-label="Nastavení cookies" hidden>
    <p>
      Používám cookies k měření návštěvnosti. Nezbytné fungují vždy, ostatní jen s&nbsp;vaším souhlasem.&nbsp;<a href="/ochrana-osobnich-udaju/">Více</a>
    </p>
    <div class="consent__actions">
      <button type="button" class="btn btn--ghost" data-consent="necessary">Jen nezbytné</button>
      <button type="button" class="btn btn--primary" data-consent="all">Přijmout vše</button>
    </div>
  </div>
)}

<script is:inline define:vars={{ cfg, enabled }}>
  (function () {
    var KEY = 'jansyblik-consent-v1';
    var granted = false;
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function write(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function loadSklik() {
      if (!cfg.sklikRtg && !cfg.sklikConv) return;
      if (window.__sklikLoaded) return; window.__sklikLoaded = true;
      var s = document.createElement('script'); s.async = true; s.src = 'https://c.seznam.cz/js/rc.js';
      s.onload = function () {
        try {
          if (window.sznIVA && window.sznIVA.IS) window.sznIVA.IS.updateIdentities({ eid: null });
          if (cfg.sklikRtg && window.rc) window.rc.retargetingHit({ rtgId: Number(cfg.sklikRtg), consent: 1 });
        } catch (e) {}
      };
      document.head.appendChild(s);
    }
    function apply(choice) {
      granted = choice === 'all';
      if (window.gtag) {
        var v = granted ? 'granted' : 'denied';
        window.gtag('consent', 'update', { ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
      }
      if (granted) loadSklik();
    }
    // Volá se po odeslání formuláře: konverze pro Google Ads, Sklik a událost pro Analytics.
    window.trackLead = function (kind) {
      try {
        if (window.gtag) {
          window.gtag('event', 'generate_lead', { form_type: kind || 'oceneni' });
          if (cfg.ads && cfg.adsLabel) window.gtag('event', 'conversion', { send_to: cfg.ads + '/' + cfg.adsLabel });
        }
        if (granted && cfg.sklikConv && window.rc) window.rc.conversionHit({ id: Number(cfg.sklikConv), value: null, consent: 1 });
      } catch (e) {}
    };
    var box = document.getElementById('consent');
    window.openConsent = function () { if (box) box.hidden = false; };
    if (!enabled) return;
    var saved = read();
    if (saved) apply(saved); else if (box) box.hidden = false;
    if (box) box.addEventListener('click', function (e) {
      var b = e.target.closest('[data-consent]'); if (!b) return;
      var c = b.getAttribute('data-consent'); write(c); apply(c); box.hidden = true;
    });
  })();
</script>

<style>
  /* Nenápadná lišta dole: jeden řádek na počítači, dva na mobilu. */
  .consent {
    position: fixed; z-index: 70; left: 0; right: 0; bottom: 0;
    background: rgba(22,22,22,.97); color: #e9e9e9; border-top: 1px solid #2e2e2e;
    padding: 10px max(16px, env(safe-area-inset-left)) calc(10px + env(safe-area-inset-bottom));
    display: flex; align-items: center; justify-content: center; gap: 10px 20px; flex-wrap: wrap;
    font-size: 13.5px; line-height: 1.45;
  }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; max-width: 640px; }
  .consent a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
  .consent__actions { display: flex; gap: 8px; flex-shrink: 0; }
  .consent__actions .btn { min-height: 36px; padding: 0 14px; font-size: 14px; }
  .consent :global(.btn--ghost) { color: #fff; border-color: #5a5a5a; background: transparent; }
  @media (max-width: 600px) {
    .consent { justify-content: stretch; padding-top: 12px; }
    .consent__actions { width: 100%; }
    .consent__actions .btn { flex: 1 1 0; justify-content: center; }
  }
</style>
