---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Stránka nenalezena | Jan Syblík" path="/404/" noindex>
  <Header />
  <main id="obsah" class="section">
    <div class="wrap nf">
      <h1>Tahle stránka tu není</h1>
      <p>Možná se změnila adresa. Zkuste úvodní stránku, nebo mi rovnou zavolejte.</p>
      <a class="btn btn--primary" href="/">Na úvodní stránku</a>
    </div>
  </main>
  <Footer />
</Base>
<style>.nf { display: grid; gap: 20px; justify-items: start; max-width: 640px; } .nf p { color: var(--muted); font-size: 18px; }</style>
